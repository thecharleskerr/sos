---
import '@sos/ui/tokens.css';
import SiteHeader from '@sos/ui/components/SiteHeader.astro';
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap">
      <SiteHeader site="sims" />
      <main><slot /></main>
      <footer class="foot">
        <p class="foot-links"><a href="/how-we-pick-deals">How we pick deals</a></p>
      </footer>
    </div>
    <style>
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 var(--space-4) var(--space-12); }
      .foot {
        margin-top: var(--space-12);
        padding-top: var(--space-6);
        border-top: 1px solid var(--rule);
        font-size: 12.5px;
        color: var(--ink-2);
        max-width: 62ch;
      }
      .foot a { color: var(--ink); }
      .foot-links { display: flex; gap: var(--space-4); flex-wrap: wrap; }
      /* 44px hit targets, geometry unchanged: added height cancels out. */
      .foot-links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin: -12px 0;
      }
    </style>
  </body>
</html>
