---
/* The footer. Links only, in small type: the sections, the method, the two
   policies. No sentence about money; the cards carry the commission line
   where it belongs. */
import { site, sections } from '../site.js';
const { year } = Astro.props;
---
<footer class="foot">
  <p class="foot-links">
    {Object.values(sections).map((s) => <a href={s.path}>{s.name}</a>)}
    <a href="/how-we-pick-deals/">How we pick deals</a>
    <a href="/about/">About</a>
    <a href="/terms/">Terms</a>
    <a href="/privacy/">Privacy</a>
  </p>
  <p class="foot-note">
    {site.name}, {year}. Figures come from the networks' and makers' own pages
    on the date shown. Deals are re-checked every Monday. Prices can change
    after that.
  </p>
</footer>

<style>
  .foot {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .foot a { color: var(--ink); }
  .foot-links { display: flex; gap: var(--space-4); flex-wrap: wrap; margin: 0; }
  /* 44px hit targets, geometry unchanged: added height cancels out. */
  .foot-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: -12px 0;
  }
  .foot-note { font-size: 11.5px; margin: var(--space-4) 0 0; max-width: 62ch; }
</style>
