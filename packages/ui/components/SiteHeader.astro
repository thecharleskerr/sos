---
/* The masthead: the wordmark with the SIM silhouette as its mark, a strap,
   and the places a reader goes. One band with an ink rule beneath it and no
   colour, so the only colour on any page is still the network's. The
   sections come first in the nav, from the list in site.js, so a third
   section appears here without a redesign. */
import { site, sections } from '../site.js';
---
<header class="bar">
  <div class="masthead">
    <div>
      <a class="brand" href="/"><span class="mark" aria-hidden="true"></span>{site.name}</a>
      <p class="strap">UK mobile deals, checked every Monday</p>
    </div>
    <nav class="nav" aria-label="Site">
      {Object.values(sections).map((s) => <a href={s.path}>{s.name}</a>)}
      <a href="/networks/">Networks</a>
      <a href="/roaming/">Roaming</a>
      <a href="/blog/">Guides</a>
    </nav>
  </div>
</header>

<style>
  .bar { background: var(--card); }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px 14px;
    border-bottom: 2px solid var(--ink);
  }
  /* Hit targets meet the 44px floor without changing the rendered geometry:
     the added height is cancelled by matching negative margins. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    margin: -7px 0;
    font-size: 21px;
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -.025em;
    color: var(--ink);
    text-decoration: none;
  }
  /* The mark is the deal card in miniature: ink, one clipped corner. */
  .mark {
    display: inline-block;
    width: 16px;
    height: 16px;
    background: var(--ink);
    clip-path: polygon(0 0, 68% 0, 100% 32%, 100% 100%, 0 100%);
  }
  .strap { font-size: 11px; color: var(--ink-2); margin: 2px 0 0; }

  .nav { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    margin: -12px -8px;
    font-size: 12.5px;
    color: var(--ink);
    text-decoration: none;
  }
  .nav a:hover { text-decoration: underline; }
</style>
