---
import Base from '../layouts/Base.astro';
import Policy from '@sos/ui/components/Policy.astro';
import { getSite } from '@sos/ui/site';
const site = getSite('phones');
---
<Base title={`Privacy | ${site.name}`} description="What this site processes about you, which is very little: hosting logs and affiliate cookies set by Awin when you follow a deal link.">
  <Policy site="phones" kind="privacy" updated="2026-09-02" />
</Base>
