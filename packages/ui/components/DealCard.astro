---
import AllowanceGrid from './AllowanceGrid.astro';
import TraceButton from './TraceButton.astro';
import { get } from '../networks.js';

const { deal } = Astro.props;
const net = get(deal.network);

const gbp = (n) => `£${n % 1 === 0 ? n : n.toFixed(2)}`;
const isMvno = net.hostNetwork !== net.name;

const roamingLine = deal.roaming.euIncluded
  ? `${deal.roaming.euCapGB}GB in the EU, no daily charge`
  : `Charged at ${gbp(deal.roaming.dailyChargeGBP)} a day in the EU`;

const picks = {
  'deal-of-week': 'Deal of the week',
  'best-roaming': 'Best for roaming',
  'best-unlimited': 'Best unlimited data',
  'cheapest': 'Cheapest this week',
  'best-short-contract': 'Best short contract',
};
---
<article class="card" style={`--network: ${net.colour}`}>
  <span class="flash" aria-hidden="true"></span>

  {deal.pick && <p class="pick">{picks[deal.pick]}</p>}

  <header class="head">
    <span class="pill">{net.name}</span>
    {isMvno && <span class="host">on {net.hostNetwork}</span>}
  </header>

  <p class="price num">{gbp(deal.monthlyPrice)}</p>
  <p class="terms num">
    a month · {gbp(deal.totalContractCost)} over {deal.contractLengthMonths} months
  </p>
  <p class="rise">{deal.priceRise.wording}</p>

  <AllowanceGrid
    data={deal.data}
    minutes={deal.minutes}
    texts={deal.texts}
    months={deal.contractLengthMonths}
  />

  <dl class="roaming">
    <dt>Roaming</dt>
    <dd>
      {roamingLine}
      {deal.roaming.note && <span class="note">{deal.roaming.note}</span>}
    </dd>
  </dl>

  <TraceButton href={deal.url} label={`See this deal at ${net.name}`} />

  <p class="checked">
    Checked {deal.lastVerified}
    {deal.isAffiliate
      ? <span> · we earn a commission on this link</span>
      : <span class="noearn"> · we don't earn from this one</span>}
  </p>
</article>

<style>
  /* The SIM card silhouette: one clipped corner, top right. */
  .card {
    position: relative;
    background: var(--card);
    border: 1px solid var(--rule);
    padding: var(--space-5);
    clip-path: polygon(
      0 0,
      calc(100% - var(--notch)) 0,
      100% var(--notch),
      100% 100%,
      0 100%
    );
  }
  .flash {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--notch);
    height: var(--notch);
    background: var(--network);
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }

  .pick {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: var(--space-1) var(--space-3);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .head { display: flex; align-items: baseline; gap: var(--space-3); }
  .pill {
    padding: var(--space-1) var(--space-3);
    border: 2px solid var(--network);
    font-weight: 600;
    font-size: var(--step--1);
  }
  .host { color: var(--ink-2); font-size: var(--step--1); }

  .price {
    margin: var(--space-3) 0 0;
    font-size: var(--step-4);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .terms { margin: var(--space-2) 0 0; color: var(--ink-2); font-size: var(--step--1); }

  /* Ofcom requires the cash-terms price rise directly under the price. */
  .rise { margin: var(--space-2) 0 0; font-size: var(--step--1); font-weight: 600; }

  .roaming { margin: 0 0 var(--space-5); }
  .roaming dt { font-size: var(--step--1); color: var(--ink-2); }
  .roaming dd { margin: var(--space-1) 0 0; font-weight: 600; }
  .note { display: block; font-weight: 400; font-size: var(--step--1); color: var(--ink-2); }

  .checked { margin: var(--space-3) 0 0; font-size: var(--step--1); color: var(--ink-2); }
  .noearn { font-weight: 600; color: var(--ink); }
</style>
