---
import Base from '../../layouts/Base.astro';
import Article from '@sos/ui/components/Article.astro';
import { getCollection, render } from 'astro:content';
import { live, dealsFor } from '@sos/ui/posts';

export async function getStaticPaths() {
  return live(await getCollection('posts')).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
/* Live cards for the picks the post names, from this site's content/. A pick
   with no live deal renders nothing rather than a stale figure. */
const deals = dealsFor('phones', post.data.deals, import.meta.url);
---
<Base title={`${post.data.title} | Save on Smartphones`} description={post.data.description}>
  <Article site="phones" siteName="Save on Smartphones" siteUrl="https://saveonsmartphones.co.uk" slug={post.id} post={post.data} deals={deals}>
    <Content />
  </Article>
</Base>
