{
  "name": "sos",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sos/quidby",
    "build": "npm run build -w @sos/quidby",
    "preview": "npm run preview -w @sos/quidby",
    "verify": "node packages/data/verify.mjs",
    "seo": "node packages/data/seo/audit.mjs apps/quidby/dist https://quidby.com",
    "test": "node --experimental-strip-types --test \"packages/data/test/*.test.mjs\"",
    "refresh": "node --experimental-strip-types packages/data/ingest/run.mjs",
    "integrity": "node --experimental-strip-types packages/data/verify/integrity.mjs"
  }
}
