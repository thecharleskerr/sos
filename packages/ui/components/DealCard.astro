---
/* The deal card. Everything a reader needs is visible without a click, a
   hover or a scroll: network, host, monthly price, total, the price rise in
   pounds and pence, the four allowances, roaming, the checked date, and
   whether we earn on the link.

   Nothing here is ever guessed. A figure the data does not carry is stated as
   unconfirmed, because a blank cell costs nothing and a wrong number costs
   the affiliate relationship. */
import AllowanceGrid from './AllowanceGrid.astro';
import TraceButton from './TraceButton.astro';
import { get, hostLabel } from '../networks.js';

const { deal, variant = 'standard' } = Astro.props;
const hero = variant === 'hero';
const net = get(deal.network);
const device = deal.device ?? null;

const gbp = (n) => `£${n % 1 === 0 ? n : n.toFixed(2)}`;

/* The rise is derived from stated values, never invented. Where the amount is
   not stated we say so rather than compute a total from a guess. */
const rise = deal.priceRise;
let riseHead;
let riseDetail;
if (rise.type === 'none') {
  riseHead = 'No price rise';
  riseDetail = `Fixed for the whole ${deal.contractLengthMonths} months.`;
} else if (typeof rise.amountGBP === 'number') {
  const to = gbp(deal.monthlyPrice + rise.amountGBP);
  riseHead = rise.month ? `Goes up to ${to} in ${rise.month}` : `Goes up to ${to} mid-contract`;
  riseDetail = `A rise of ${gbp(rise.amountGBP)} a month, and ${gbp(rise.amountGBP * 12)} over the year.`;
} else {
  riseHead = rise.wording;
  riseDetail = 'The amount is not stated in pounds and pence.';
}

const roam = deal.roaming;
let roamHead;
if (roam.euIncluded === true) {
  roamHead = roam.euCapGB === null
    ? 'Included in the EU, no daily charge'
    : `${roam.euCapGB}GB in the EU, no daily charge`;
} else if (roam.euIncluded === false) {
  roamHead = roam.dailyChargeGBP === null
    ? 'Not included in the EU'
    : `Charged at ${gbp(roam.dailyChargeGBP)} a day in the EU`;
} else {
  roamHead = 'EU roaming not confirmed';
}
const roamDetail = roam.note
  ?? (roam.euIncluded === true && roam.euCapGB === null ? `Cap not yet confirmed with ${net.name}.` : null);

const checked = new Date(deal.lastVerified).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const foot = deal.isAffiliate
  ? `Checked ${checked}. We earn a commission if you switch through this link.`
  : `Checked ${checked}. No commission on this link.`;

const picks = {
  'deal-of-week': 'Deal of the week',
  'best-roaming': 'Best for roaming',
  'best-unlimited': 'Best unlimited data',
  cheapest: 'Cheapest this week',
  'best-short-contract': 'Best short contract',
};

const host = hostLabel(net);
const isDirect = net.hostNetwork === 'direct';
const style = `--network: ${net.colour}; --pill-text: ${net.pillText}${hero ? '; --cut: 36px' : ''}`;
---
<article class:list={['ticket', hero && 'hero', hero && 'settle']} style={style}>
  <span class:list={['flash', net.inkClash && 'flash--ink']} aria-hidden="true"></span>
  {deal.pick && <p class="mark">{picks[deal.pick]}</p>}

  <div class:list={['body', hero && 'body--hero']}>
    <div class:list={hero && 'col-left'}>
      {device ? (
        <div class="handset">
          <div class="imgslot" aria-hidden="true">Handset image</div>
          <div class="handset-meta">
            <span class:list={['pill', net.inkClash && 'pill--ink']}>{net.name}</span>
            <p class="t-dealname devname">{device.name}<br />{device.storageGB}GB</p>
            <div class="swatches">
              {device.colours.map((c) => <span style={`background: ${c.hex}`} title={c.name}></span>)}
            </div>
            <p class="finishes">{device.colours.map((c) => c.name).join(', ')}</p>
          </div>
        </div>
      ) : (
        <div class="netrow">
          <span class:list={['pill', net.inkClash && 'pill--ink']}>{net.name}</span>
          {isDirect ? <span class="t-meta">{host}</span> : <span class="pill-host">{host}</span>}
        </div>
      )}

      <div>
        <p class="price">
          <span class:list={['amt', hero ? 't-price-hero' : 't-price']}>{gbp(deal.monthlyPrice)}</span>
          <span class="per">a month</span>
        </p>
        <p class="total">
          {deal.upfrontCost > 0 && <>{gbp(deal.upfrontCost)} upfront<br /></>}
          {deal.upfrontCost === 0 && device && <>£0 upfront<br /></>}
          {gbp(deal.totalContractCost)} over {deal.contractLengthMonths} months
        </p>
      </div>

      <div class:list={hero ? 'riseblock' : 'band'}>
        <p class:list={hero ? 'risehead-hero' : 't-support'}>{riseHead}</p>
        <p class="detail">{riseDetail}</p>
      </div>
    </div>

    <div class:list={hero && 'col-right'}>
      <AllowanceGrid
        data={deal.data}
        minutes={deal.minutes}
        texts={deal.texts}
        months={deal.contractLengthMonths}
        pad={hero ? '11px 9px' : undefined}
      />

      {hero ? (
        <div class="band">
          <p class="roam-label">Roaming</p>
          <p class="t-support">{roamHead}</p>
          {roamDetail && <p class="detail">{roamDetail}</p>}
        </div>
      ) : (
        <div class="roam">
          <p class="roam-label">Roaming</p>
          <div>
            <p class="t-support">{roamHead}</p>
            {roamDetail && <p class="detail">{roamDetail}</p>}
          </div>
        </div>
      )}

      {!deal.isAffiliate && (
        <div class="no-earn">
          <strong>We don't earn from this one</strong>
          <p class="detail">{net.note ?? `${net.name} has no affiliate programme. It is here because leaving it out would make the list a lie.`}</p>
        </div>
      )}

      <TraceButton
        href={deal.url}
        label={`See this deal at ${net.name}`}
        outlined={!deal.isAffiliate}
        rel={deal.isAffiliate ? 'sponsored nofollow' : 'nofollow'}
      />
      <p class="foot">{foot}</p>
    </div>
  </div>
</article>

<style>
  .mark { margin: 0; }
  .body { padding: 18px 20px; display: flex; flex-direction: column; gap: 15px; }
  .body > div { display: flex; flex-direction: column; gap: 15px; }

  .netrow { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }

  .price { display: flex; align-items: baseline; gap: 9px; margin: 0; }
  /* This span wraps in a narrow column without both of these. */
  .per { font-size: 14px; color: var(--ink-2); white-space: nowrap; flex: none; }
  .total { font-size: 13.5px; color: var(--ink-2); margin: 7px 0 0; }

  .band { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 11px 0; }
  .band > p, .roam p, .no-earn p { margin: 0; }
  .detail { font-size: 12.5px; color: var(--ink-2); margin-top: 2px !important; }

  .roam { display: grid; grid-template-columns: 74px 1fr; gap: 12px; padding: 12px 0;
          border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .roam-label { font-size: 12px; color: var(--ink-2); margin: 0; }
  .roam > div { display: block; }

  .no-earn { border: 2px solid var(--ink); padding: 12px 14px; }
  .no-earn strong { font-size: 14px; font-weight: 700; }

  .foot { font-size: 12px; color: var(--ink-2); line-height: 1.45; margin: 0; }

  /* Handset */
  .handset { display: flex; gap: 16px; }
  .imgslot { width: 78px; height: 104px; flex: none; background: #E7E8E6;
             border: 1px solid var(--rule); color: var(--ink-2); font-size: 10.5px;
             display: flex; align-items: center; justify-content: center; text-align: center; padding: 6px; }
  .handset-meta { flex: 1; min-width: 0; }
  .devname { margin: 10px 0 0; line-height: 1.2; }
  .swatches { display: flex; gap: 7px; margin-top: 11px; }
  .swatches span { width: 22px; height: 22px; border: 1px solid var(--rule); }
  /* Never colour alone: the finishes are written out as well as shown. */
  .finishes { font-size: 11.5px; color: var(--ink-2); margin: 6px 0 0; }

  /* Deal of the week */
  .hero { width: 100%; }
  .body--hero { flex-direction: row; gap: 28px; padding: 20px 26px 24px; }
  .col-left { flex: 1; gap: 16px; }
  .col-right { width: 372px; flex: none; }
  .riseblock { border-top: 2px solid var(--ink); padding-top: 11px; }
  .risehead-hero { font-size: 17px; font-weight: 600; margin: 0; }
  .hero .per { font-size: 16px; }
  .hero .total { font-size: 14px; margin-top: 9px; }

  @media (max-width: 52rem) {
    .body--hero { flex-direction: column; gap: 15px; padding: 18px 20px; }
    .col-right { width: 100%; }
    .hero .amt { font-size: 58px; letter-spacing: -.03em; line-height: .9; }
  }
</style>
