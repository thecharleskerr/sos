---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { live } from '@sos/ui/posts';

const posts = live(await getCollection('posts'));
const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base
  crumbs={[{ name: 'Guides', path: '/blog/' }]}
  title="Phone deal guides | Save on Smartphones"
  description="Straight answers to the questions people ask before they buy a phone, with the figures checked against the makers' and networks' own pages."
>
  <h1 class="t-h1">Phone deal guides</h1>
  <p class="lede">Straight answers to the questions people ask before they buy a phone, with the figures checked against the makers' and networks' own pages.</p>

  <div class="about">
    <p>Each guide answers one question in its first paragraph, then shows the working. The maker's price comes from the maker's own page on the date beside it, and the daily check flags a guide once its figures are more than three months old. The guides cover what a contract should cost against buying the phone outright, whether a refurbished iPhone is worth it, what your old phone is worth in trade-in, how to leave a contract early, and the cheapest 5G phone worth buying.</p>
    <p>The reference pages sit alongside them: <a href="/">this week's phone deals</a> and <a href="/how-we-pick-deals/">how the weekly picks are chosen</a>. SIM only plans for a phone bought outright are on <a href="https://saveonsims.co.uk/">Save on Sims</a>.</p>
  </div>

  {posts.length === 0 && <p class="empty">The first guides land this month.</p>}

  <ol class="list">
    {posts.map((p) => (
      <li>
        <p class="date"><time datetime={new Date(p.data.publishDate).toISOString().slice(0, 10)}>{fmt(p.data.publishDate)}</time></p>
        <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
        <p class="desc">{p.data.answer}</p>
      </li>
    ))}
  </ol>
</Base>

<style>
  h1 { margin: var(--space-8) 0 var(--space-3); max-width: 20ch; }
  .lede { max-width: 60ch; color: var(--ink-2); margin: 0 0 var(--space-8); }
  .about { max-width: 66ch; margin: 0 0 var(--space-8); }
  .about p { margin: 0 0 var(--space-3); }
  .empty { color: var(--ink-2); }
  .list { list-style: none; margin: 0; padding: 0; max-width: 72ch; border-top: 2px solid var(--ink); }
  .list li { padding: var(--space-4) 0; border-bottom: 1px solid var(--rule); }
  .date { font-size: 12.5px; color: var(--ink-2); margin: 0 0 4px; }
  .list h2 { font-size: 20px; font-weight: 800; letter-spacing: -.015em; line-height: 1.2; margin: 0 0 6px; text-wrap: balance; }
  .list h2 a { text-decoration: none; }
  .list h2 a:hover { text-decoration: underline; }
  .desc { margin: 0; font-size: 14.5px; color: var(--ink-2); max-width: 62ch; }
</style>
