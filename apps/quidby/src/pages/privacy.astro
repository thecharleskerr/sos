---
import Base from '../layouts/Base.astro';
import Policy from '@sos/ui/components/Policy.astro';
import { getSite } from '@sos/ui/site';
const site = getSite();
---
<Base crumbs={[{ name: 'Privacy', path: '/privacy/' }]} title={`Privacy: what ${site.name} processes, which is very little`} description="What this site processes about you, which is very little: hosting logs and affiliate cookies set by Awin when you follow a deal link.">
  <Policy kind="privacy" updated="2026-09-02" />
</Base>
