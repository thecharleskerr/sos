---
/* The signature element. A line in the network's colour draws itself around
   the button on hover and on keyboard focus. Once, 600ms, then it rests.
   Under prefers-reduced-motion it becomes a static border. */
const { href, label } = Astro.props;
---
<a class="trace" href={href} rel="sponsored nofollow">
  <svg class="outline" aria-hidden="true" preserveAspectRatio="none">
    <rect x="1.5" y="1.5" width="calc(100% - 3px)" height="calc(100% - 3px)" />
  </svg>
  <span>{label}</span>
</a>
<style>
  .trace {
    position: relative;
    display: block;
    padding: var(--space-4);
    text-align: center;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--rule);
  }
  .outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .outline rect {
    fill: none;
    stroke: var(--network);
    stroke-width: 3;
    pathLength: 100;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .trace:hover .outline rect,
  .trace:focus-visible .outline rect {
    animation: draw 600ms ease-out forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .outline rect { stroke-dashoffset: 0; opacity: 0; }
    .trace:hover .outline rect,
    .trace:focus-visible .outline rect { opacity: 1; animation: none; }
  }
</style>
